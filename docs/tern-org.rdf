  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/orcID">
    <rdfs:domain rdf:resource="https://w3id.org/tern/ontologies/org/Person"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:seeAlso rdf:resource="https://orcid.org/"/>
    <rdfs:subPropertyOf rdf:resource="http://schema.org/identifier"/>
    <rdfs:label>Open Researcher and Contributer ID (ORCID)</rdfs:label>
    <skos:definition>The ORCID is a nonproprietary alphanumeric code to uniquely identify scientific and other academic authors and contributors.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/Consortium">
