  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/agorID">
    <rdfs:label>AGOR ID</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://data.gov.au/data/dataset/australian-government-organisations-register"/>
    <rdfs:subPropertyOf rdf:resource="http://schema.org/identifier"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <schema:rangeIncludes rdf:resource="http://schema.org/Text"/>
    <schema:domainIncludes rdf:resource="http://schema.org/Organization"/>
    <rdfs:domain rdf:resource="https://w3id.org/tern/ontologies/org/Organization"/>
    <skos:definition>The Australian Government Organisations Register ID</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/Cooperative">
    <rdfs:comment>An organization that is a joint project of multiple organizations or persons.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdfs:label>Cooperative</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/Organization">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Organization"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tern/ontologies/org/Agent"/>
    <rdfs:label>Organization</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66">
    <schema:name>Terrestrial Ecosystem Research Network</schema:name>
    <schema:alternateName>TERN</schema:alternateName>
    <schema:url rdf:resource="https://www.tern.org.au/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/FundingAgency">
    <rdfs:label>Funding Agency</rdfs:label>
    <rdfs:comment>A FundingAgency is an organization that implements one or more FundingSchemes and manages the granting process (via Grants, typically MonetaryGrants). A funding agency is not always required for grant funding, e.g. philanthropic giving, corporate sponsorship etc.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/Project"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ub1bL150C15">
    <schema:affiliation rdf:resource="https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66"/>
    <schema:name>Edmond Chuc</schema:name>
    <schema:identifier>https://orcid.org/0000-0002-6047-9864</schema:identifier>
    <schema:email>e.chuc@uq.edu.au</schema:email>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/AustralianStateGovernmentOrganization">
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:comment>State governments.</rdfs:comment>
    <rdfs:label>State Government Organization (deprecated)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tern/ontologies/org/AustralianGovernmentOrganization"/>
    <dct:isReplacedBy rdf:resource="https://w3id.org/tern/ontologies/org/StateGovernmentOrganization"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/areaServed">
    <rdfs:comment>The geographic area where a service or offered item is provided.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>area served</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/member">
    <rdfs:label>member</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:comment>A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/EducationalOrganization">
    <rdfs:comment>An educational organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdfs:label>Educational Organization</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/Agent">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    <rdfs:label>Agent</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:scopeNote>Common superclass of tern-org:Person and tern-org:Organization, aligned with PROV-O.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/NCRISProject">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tern/ontologies/org/Project"/>
    <rdfs:seeAlso rdf:resource="https://www.education.gov.au/national-collaborative-research-infrastructure-strategy-ncris"/>
    <rdfs:label>NCRIS Project (deprecated)</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <dct:isReplacedBy rdf:resource="http://schema.org/Project"/>
    <rdfs:comment>National Collaborative Research Infrastructure Strategy (NCRIS) is a national network of world-class research infrastructure projects that support high-quality research that will drive greater innovation in the Australian research sector and the economy more broadly. Projects support strategically important research through which Australian researchers and their international partners can address key national and global challenges.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/LocalBusiness">
    <rdfs:subClassOf rdf:resource="https://w3id.org/tern/ontologies/org/Organization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/LocalBusiness"/>
    <rdfs:label>Local business (deprecated)</rdfs:label>
    <dct:isReplacedBy rdf:resource="http://schema.org/LocalBusiness"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/goodrelations/v1#BusinessEntity">
    <rdfs:label>Business entity</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#FormalOrganization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/FundingScheme">
    <rdfs:comment>A FundingScheme combines organizational, project and policy aspects of grant-based funding that sets guidelines, principles and mechanisms to support other kinds of projects and activities. Funding is typically organized via Grant funding. Examples of funding schemes: Swiss Priority Programmes (SPPs); EU Framework 7 (FP7); Horizon 2020; the NIH-R01 Grant Program; Wellcome institutional strategic support fund. For large scale public sector funding, the management and administration of grant awards is often handled by other, dedicated, organizations - FundingAgencys such as ERC, REA, ...</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdfs:label>Funding Scheme</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/Site">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Site"/>
    <rdfs:label>Site</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/Corporation">
    <rdfs:subClassOf rdf:resource="http://schema.org/Organization"/>
    <rdfs:comment>A business corporation.</rdfs:comment>
    <rdfs:label>Corporation</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/EducationalOrganization">
    <dct:isReplacedBy rdf:resource="http://schema.org/EducationalOrganization"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/tern/ontologies/org/Organization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://schema.org/EducationalOrganization"/>
    <rdfs:label>Educational organization (deprecated)</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/hasRole">
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <skos:definition>Link an [Agent](#Agent) to a [Role](#Role).</skos:definition>
    <rdfs:label>has role</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/memberOf">
    <rdfs:comment>An Organization (or ProgramMembership) to which this Person or Organization belongs.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>member of</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://schema.org/funder">
    <rdfs:comment>A person or organization that supports (sponsors) something through some kind of financial contribution.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdfs:label>funder</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/GovernmentOrganization">
