    <owl:imports rdf:resource="http://topbraid.org/schema/"/>
    <dct:publisher rdf:resource="https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-02</dct:modified>
