  {
    "@id": "https://w3id.org/tern/ontologies/org/NCRISProject",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/isReplacedBy": [
      {
        "@id": "http://schema.org/Project"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "National Collaborative Research Infrastructure Strategy (NCRIS) is a national network of world-class research infrastructure projects that support high-quality research that will drive greater innovation in the Australian research sector and the economy more broadly. Projects support strategically important research through which Australian researchers and their international partners can address key national and global challenges."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "NCRIS Project (deprecated)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.education.gov.au/national-collaborative-research-infrastructure-strategy-ncris"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/tern/ontologies/org/Project"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@value": true
      }
    ]
  },
