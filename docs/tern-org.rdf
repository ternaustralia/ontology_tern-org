  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/tern/ontologies/org/Role">
    <skos:example>@prefix tern-org: &lt;https://w3id.org/tern/ontologies/org/&gt; .
@prefix tern: &lt;https://w3id.org/tern/ontologies/tern/&gt; .
@prefix schema: &lt;http://schema.org/&gt; .
@prefix dcterms: &lt;http://purl.org/dc/terms/&gt; .
@prefix rdf: &lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#&gt; .
@prefix xsd: &lt;http://www.w3.org/2001/XMLSchema#&gt; .

&lt;Person1&gt; a tern-org:Person ;
	tern-org:hasRole &lt;Role1&gt; .

&lt;Role1&gt; a tern-org:Role ;
	dcterms:type &lt;Investigator&gt; ;
	rdf:value &lt;Person1&gt; ;
	schema:startDate "2020-08-24"^^xsd:date ;
	tern-org:appliesOn &lt;Site1&gt; .

&lt;Site1&gt; a tern:Site ;
	tern-org:hasRef &lt;Role1&gt; .</skos:example>
    <rdfs:subClassOf rdf:resource="http://schema.org/Role"/>
    <skos:definition>Represents additional information about a relationship or property. For example a Role can be used to say that a 'member' role linking some SportsTeam to a player occurred during a particular time period. Or that a Person's 'actor' role in a Movie was for some particular characterName. Such properties can be attached to a Role entity, which is then associated with the main entities using ordinary properties like 'member' or 'actor'.\n\nSee also [blog post](http://blog.schema.org/2014/06/introducing-role.html).</skos:definition>
    <skos:example>Funder role with a start date.

@prefix tern-org: &lt;https://w3id.org/tern/ontologies/org/&gt; .
@prefix schema: &lt;http://schema.org/&gt; .
@prefix dcterms: &lt;http://purl.org/dc/terms/&gt; .
@prefix rdf: &lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#&gt; .
@prefix xsd: &lt;http://www.w3.org/2001/XMLSchema#&gt; .

&lt;Project1&gt; a schema:Project ;
	schema:funder &lt;Funder1&gt; ;
	tern-org:hasRef &lt;Role2&gt; .

&lt;Role2&gt; a tern-org:Role ;
	dcterms:type &lt;http://linked.data.gov.au/def/tern-cv/c03f42d5-619e-41d3-819f-67b48f5452f3&gt; ;
	rdf:value &lt;Funder1&gt; ;
	tern-org:appliesOn &lt;Project1&gt; ;
	schema:startDate "2023-07-01"^^xsd:date ;
	schema:name "Funder - Funder1 - 2023-07-01" .

&lt;Funder1&gt; a schema:Organization ;
	tern-org:hasRole &lt;Role2&gt; .</skos:example>
    <rdfs:label>Role</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:scopeNote>Use the [dcterms:type](http://purl.org/dc/terms/type) property to link the type of [Role](#Role) to a controlled vocabulary term. E.g. One of the values from [TERN's Roles](http://linked.data.gov.au/def/tern-cv/67feb077-32da-4044-8e89-bddc21ef58ed).</skos:scopeNote>
  </rdf:Description>
