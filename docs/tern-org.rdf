    <rdfs:comment>A small profile of schema.org and the W3C Organisations ontology containing several classes to describe people and organisations with additional properties. </rdfs:comment>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
  </rdf:Description>
