  {
    "@id": "https://w3id.org/tern/resources/a083902d-d821-41be-b663-1d7cb33eea66",
    "http://schema.org/alternateName": [
      {
        "@value": "TERN"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Terrestrial Ecosystem Research Network"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://www.tern.org.au/"
      }
    ]
  },
  {
    "@id": "http://schema.org/FundingScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@value": "A FundingScheme combines organizational, project and policy aspects of grant-based funding that sets guidelines, principles and mechanisms to support other kinds of projects and activities. Funding is typically organized via Grant funding. Examples of funding schemes: Swiss Priority Programmes (SPPs); EU Framework 7 (FP7); Horizon 2020; the NIH-R01 Grant Program; Wellcome institutional strategic support fund. For large scale public sector funding, the management and administration of grant awards is often handled by other, dedicated, organizations - FundingAgencys such as ERC, REA, ..."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Funding Scheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://schema.org/Organization"
      }
    ]
  },
  {
    "@id": "https://w3id.org/tern/ontologies/org/fullAddressLine",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://schema.org/PostalAddress"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Full Address Line"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/2000/01/rdf-schema#label"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The full address or canonical address of the postal address in a single line."
      }
    ]
  },
  {
    "@id": "https://w3id.org/tern/ontologies/org/hasRole",
    "@type": [
      "http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "has role"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Link an [Agent](#Agent) to a [Role](#Role)."
      }
    ]
  },
  {
    "@id": "https://w3id.org/tern/ontologies/org/Role",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "Role"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://schema.org/Role"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Represents additional information about a relationship or property. For example a Role can be used to say that a 'member' role linking some SportsTeam to a player occurred during a particular time period. Or that a Person's 'actor' role in a Movie was for some particular characterName. Such properties can be attached to a Role entity, which is then associated with the main entities using ordinary properties like 'member' or 'actor'.\\n\\nSee also [blog post](http://blog.schema.org/2014/06/introducing-role.html)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@value": "@prefix tern-org: <https://w3id.org/tern/ontologies/org/> .\n@prefix tern: <https://w3id.org/tern/ontologies/tern/> .\n@prefix schema: <http://schema.org/> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n<Person1> a tern-org:Person ;\n\ttern-org:hasRole <Role1> .\n\n<Role1> a tern-org:Role ;\n\tdcterms:type <Investigator> ;\n\trdf:value <Person1> ;\n\tschema:startDate \"2020-08-24\"^^xsd:date ;\n\ttern-org:appliesOn <Site1> .\n\n<Site1> a tern:Site ;\n\ttern-org:hasRef <Role1> ."
      },
      {
        "@value": "Funder role with a start date.\n\n@prefix tern-org: <https://w3id.org/tern/ontologies/org/> .\n@prefix schema: <http://schema.org/> .\n@prefix dcterms: <http://purl.org/dc/terms/> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n\n<Project1> a schema:Project ;\n\tschema:funder <Funder1> ;\n\ttern-org:hasRef <Role2> .\n\n<Role2> a tern-org:Role ;\n\tdcterms:type <http://linked.data.gov.au/def/tern-cv/c03f42d5-619e-41d3-819f-67b48f5452f3> ;\n\trdf:value <Funder1> ;\n\ttern-org:appliesOn <Project1> ;\n\tschema:startDate \"2023-07-01\"^^xsd:date ;\n\tschema:name \"Funder - Funder1 - 2023-07-01\" .\n\n<Funder1> a schema:Organization ;\n\ttern-org:hasRole <Role2> ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@value": "Use the [dcterms:type](http://purl.org/dc/terms/type) property to link the type of [Role](#Role) to a controlled vocabulary term. E.g. One of the values from [TERN's Roles](http://linked.data.gov.au/def/tern-cv/67feb077-32da-4044-8e89-bddc21ef58ed)."
      }
    ]
